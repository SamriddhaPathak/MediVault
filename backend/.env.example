NODE_ENV=development
PORT=5000

# Single-container/local dev: SQLite via Prisma (no external Postgres/Docker needed).
# To move to production Postgres, change the datasource in prisma/schema.prisma
# to `provider = "postgresql"` and set DATABASE_URL to a Postgres connection string.
DATABASE_URL="file:./dev.db"

JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Local filesystem storage (dev). Swap StorageService implementation for S3 in production.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads

MAX_UPLOAD_SIZE_BYTES=15728640
OCR_LANGUAGE=eng

EXPORT_LOCAL_DIR=./generated
EXPORT_URL_TTL_MINUTES=15
