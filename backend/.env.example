NODE_ENV=development
PORT=5000

# Single-container/local dev: SQLite via Prisma (no external Postgres/Docker needed).
# To move to production Postgres, change the datasource in prisma/schema.prisma
# to `provider = "postgresql"` and set DATABASE_URL to a Postgres connection string.
DATABASE_URL="file:./dev.db"

# Development placeholders. In production these must be set explicitly to
# real, unique secrets of at least 32 characters — the process refuses to
# start otherwise (see src/config/env.ts). The access secret also signs the
# HMAC file-access tokens, so a default value here would let anyone mint a
# valid link to any stored file.
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Local filesystem storage (dev). Swap StorageService implementation for S3 in production.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads

MAX_UPLOAD_SIZE_BYTES=15728640
OCR_LANGUAGE=eng

# Directory containing <language>.traineddata. Optional: the backend already
# looks in TESSDATA_DIR, ./tessdata and the backend root, and the repo ships
# eng.traineddata in the backend root — so OCR works with no network access.
# If no local file is found for OCR_LANGUAGE, tesseract.js downloads it on
# first use instead.
# TESSDATA_DIR=./tessdata

EXPORT_LOCAL_DIR=./generated
EXPORT_URL_TTL_MINUTES=15
